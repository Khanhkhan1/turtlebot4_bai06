<?xml version="1.0"?>
<!-- Fixed camera looking at the robot's working area: its image (/overview_camera/image) is the
     Gazebo view shown in RViz2, since the Gazebo GUI does not run on macOS. Pose is set at spawn. -->
<sdf version="1.8">
  <model name="overview_camera">
    <static>true</static>
    <link name="link">
      <sensor name="camera" type="camera">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>overview_camera/image</topic>
        <camera>
          <horizontal_fov>1.1</horizontal_fov>
          <image>
            <width>800</width>
            <height>600</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
